# Token do bot, criado com o @BotFather no Telegram
BOT_TOKEN=

# Seu chat_id no Telegram — só mensagens vindas dele são aceitas.
# Descubra o seu falando com @userinfobot ou @RawDataBot.
ALLOWED_CHAT_ID=

# Token compartilhado com o app (configurado na página Importação) — invente uma string aleatória longa.
SYNC_TOKEN=

# Porta HTTP do servidor
PORT=3000

# Caminho do arquivo SQLite (mantenha num volume Docker persistente)
DB_PATH=./data/events.sqlite

# ─── Opcionais ────────────────────────────────────────────────────────────────

# IA do bot: frases livres, perguntas sobre os gastos e dicas da fatura.
# auto (padrão) usa os CLIs logados neste PC — Antigravity (agy) e depois Claude Code —
# e, sem nenhum, a API do Gemini abaixo (que só interpreta frases). Valores: auto | gemini | off
# ou uma lista em ordem de preferência, cada IA com modelo opcional. Ex.: claude:opus,antigravity
# usa o Opus e, se o Claude não estiver logado ou falhar (limite, timeout), o Antigravity.
# Sem modelo: frases com o rápido (gemini-3.8-flash-medium / haiku) e dicas com gemini-4-argon-medium / sonnet;
# com modelo, ele vale para os dois.
BOT_AI=auto
# Formato antigo: modelo da primeira IA da lista quando ela não traz um.
BOT_AI_MODEL=

# Plano B sem CLI: interpretação pela API do Gemini.
# Gere em https://aistudio.google.com/apikey (começa com "AIzaSy").
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Lembrete automático de quem está devendo.
# REMINDER_WEEKDAY: 0=domingo, 1=segunda ... 6=sábado. Deixe vazio para desligar.
REMINDER_WEEKDAY=
REMINDER_HOUR=9
