{
  "name": "financas-telegram-sync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bot do Telegram + fila de eventos para sincronizar 'quem me deve' com o app de controle financeiro.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--experimental-sqlite tsx watch --include .env src/index.ts",
    "build": "tsc -b",
    "start": "node --experimental-sqlite dist/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
